{
  "name": "sandforge",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "A web particle-physics laboratory — falling-sand simulation with depth layers, instrumentation and a research loop.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bench": "node tools/bench.mjs",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raccoon-mh/sandforge.git"
  },
  "homepage": "https://raccoon-mh.github.io/sandforge/",
  "keywords": [
    "falling-sand",
    "simulation",
    "cellular-automata",
    "webgl",
    "physics",
    "sandbox",
    "powder-toy"
  ]
}
